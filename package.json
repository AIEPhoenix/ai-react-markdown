{
  "name": "ai-markdown",
  "version": "3.0.0-beta.2",
  "private": true,
  "type": "module",
  "description": "Framework-independent Markdown engine and shared core with React rendering and Mantine integration.",
  "scripts": {
    "build": "pnpm --filter './packages/*' run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.storybook.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version-packages": "node scripts/version-packages.mjs",
    "packcheck": "pnpm --filter './packages/*' -r exec attw --pack . && pnpm --filter './packages/*' -r exec publint",
    "check:overrides": "node scripts/assert-overrides-in-sync.mjs",
    "check:soak-coverage": "node scripts/soak/assert-coverage-map.mjs",
    "bench": "vitest bench --run --project unit",
    "bench:web": "node benchmarks/runner/run.mjs",
    "bench:web:selftest": "node benchmarks/runner/selftest.mjs",
    "bench:web:scale": "node benchmarks/runner/scale.mjs --prefix scale-",
    "bench:web:scale:cold": "node benchmarks/runner/scale.mjs --prefix cold-",
    "bench:web:scale:steps": "node benchmarks/runner/scale.mjs --prefix steps-",
    "preflight": "pnpm check:overrides && pnpm check:soak-coverage && pnpm lint && pnpm format:check && pnpm build && pnpm check:public-api && pnpm test:soak-control && pnpm test:release-control && pnpm packcheck && pnpm -r typecheck && pnpm typecheck && pnpm vitest run && pnpm test:document-lifetime && pnpm test:vue-browser && pnpm test:packed-consumers",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:soak-control": "node --test scripts/soak/soak-control.test.mjs",
    "test:document-lifetime": "node scripts/test-document-scope-lifetime.mjs",
    "test:packed-consumers": "node scripts/check-packed-consumers.mjs",
    "check:public-api": "node scripts/check-public-api.mjs",
    "test:vue-browser": "node scripts/test-vue-browser.mjs",
    "test:release-control": "node --test scripts/publish-packages.test.mjs"
  },
  "keywords": [
    "react",
    "markdown",
    "ai",
    "llm",
    "latex",
    "katex",
    "gfm",
    "streaming",
    "react-markdown"
  ],
  "author": "Brian Lee <aiephoenixbl@gmail.com> (https://github.com/AIEPhoenix)",
  "license": "MIT",
  "homepage": "https://github.com/ai-markdown/ai-markdown#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-markdown/ai-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/ai-markdown/ai-markdown/issues"
  },
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/unist": "^3.0.3",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "katex": "^0.17.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.28",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "react-scan": "^0.5.7",
    "sass": "^1.103.1",
    "storybook": "^10.5.10",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.11"
  }
}
