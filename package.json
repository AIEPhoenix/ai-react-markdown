{
  "name": "ai-react-markdown",
  "version": "2.5.5",
  "private": true,
  "type": "module",
  "description": "A React component for rendering AI-generated Markdown with LaTeX math, GFM, syntax highlighting and more.",
  "scripts": {
    "build": "pnpm --filter './packages/*' run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.storybook.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version-packages": "node scripts/version-packages.mjs",
    "packcheck": "pnpm --filter './packages/*' -r exec attw --pack . && pnpm --filter './packages/*' -r exec publint",
    "check:overrides": "node scripts/assert-overrides-in-sync.mjs",
    "bench": "vitest bench --run --project unit",
    "preflight": "pnpm check:overrides && pnpm lint && pnpm format:check && pnpm build && pnpm packcheck && pnpm -r typecheck && pnpm typecheck && pnpm vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "react",
    "markdown",
    "ai",
    "llm",
    "latex",
    "katex",
    "gfm",
    "streaming",
    "react-markdown"
  ],
  "author": "Brian Lee <aiephoenixbl@gmail.com> (https://github.com/AIEPhoenix)",
  "license": "MIT",
  "homepage": "https://github.com/AIEPhoenix/ai-react-markdown#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIEPhoenix/ai-react-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/AIEPhoenix/ai-react-markdown/issues"
  },
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/unist": "^3.0.3",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "katex": "^0.17.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "react-scan": "^0.5.7",
    "sass": "^1.102.0",
    "storybook": "^10.5.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.10"
  }
}
