{
  "name": "@ai-react-markdown/engine",
  "version": "2.3.2",
  "description": "Framework-agnostic Markdown engine for ai-react-markdown — incremental parsing, LaTeX preprocessing, and the unified plugin pipeline. Internal supplier for @ai-react-markdown/core; no public API stability promised before 3.0.0.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "license": "MIT",
  "author": "Brian Lee <aiephoenixbl@gmail.com> (https://github.com/AIEPhoenix)",
  "homepage": "https://github.com/AIEPhoenix/ai-react-markdown/tree/main/packages/engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIEPhoenix/ai-react-markdown.git",
    "directory": "packages/engine"
  },
  "bugs": {
    "url": "https://github.com/AIEPhoenix/ai-react-markdown/issues"
  },
  "keywords": [
    "markdown",
    "ai",
    "llm",
    "streaming",
    "incremental",
    "remark",
    "rehype",
    "unified",
    "hast"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "development": {
        "import": "./dist/index.dev.js",
        "require": "./dist/index.dev.cjs"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup && node scripts/assert-dist-clean.mjs",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fuzz:splice": "vitest --run src/components/incrementalParse/spliceFuzz.test.ts",
    "soak": "./scripts/run-soak.sh"
  },
  "peerDependencies": {
    "katex": "^0.16.0 || ^0.17.0"
  },
  "peerDependenciesMeta": {
    "katex": {
      "optional": true
    }
  },
  "dependencies": {
    "@ai-react-markdown/remark-mark-highlight": "workspace:^",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "devlop": "^1.1.0",
    "html-url-attributes": "^3.0.1",
    "mdast-util-to-hast": "^13.2.1",
    "micromark-util-html-tag-name": "^2.0.1",
    "micromark-util-normalize-identifier": "^2.0.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-unwrap-images": "^1.0.0",
    "remark-breaks": "^4.0.0",
    "remark-cjk-friendly": "^2.0.1",
    "remark-cjk-friendly-gfm-strikethrough": "^2.0.1",
    "remark-definition-list": "^2.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-pangu": "^2.2.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-remove-comments": "^1.1.1",
    "remark-smartypants": "^3.0.3",
    "remark-squeeze-paragraphs": "^6.0.0",
    "remend": "^1.3.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/lodash-es": "^4.17.12",
    "@types/unist": "^3.0.3",
    "fast-check": "^4.9.0",
    "hast-util-sanitize": "^5.0.2",
    "hastscript": "^9.0.1",
    "lodash-es": "^4.18.0"
  }
}
