{
  "name": "@ai-react-markdown/mantine",
  "version": "1.6.1",
  "description": "Mantine UI integration for ai-react-markdown — themed typography, syntax highlighting via @mantine/code-highlight, Mermaid diagrams, and automatic color scheme detection.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "license": "MIT",
  "author": "Brian Lee <aiephoenixbl@gmail.com> (https://github.com/AIEPhoenix)",
  "homepage": "https://github.com/AIEPhoenix/ai-react-markdown/tree/main/packages/mantine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIEPhoenix/ai-react-markdown.git",
    "directory": "packages/mantine"
  },
  "bugs": {
    "url": "https://github.com/AIEPhoenix/ai-react-markdown/issues"
  },
  "keywords": [
    "react",
    "markdown",
    "ai",
    "llm",
    "mantine",
    "katex",
    "mermaid",
    "syntax-highlighting",
    "streaming"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/index.css"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@ai-react-markdown/core": "^1.6.1",
    "@mantine/code-highlight": "^9.0.0",
    "@mantine/core": "^9.0.0",
    "highlight.js": "^11.11.1",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "deep-parse-json": "^2.0.0",
    "mermaid": "^11.15.0"
  },
  "devDependencies": {
    "@ai-react-markdown/core": "workspace:*",
    "@mantine/code-highlight": "^9.4.1",
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.5",
    "autoprefixer": "^10.5.4",
    "esbuild-sass-plugin": "^3.7.0",
    "highlight.js": "^11.11.1",
    "lodash-es": "^4.18.0",
    "postcss": "^8.5.19",
    "tsup": "^8.5.1"
  }
}
