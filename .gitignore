.DS_Store

.claude/*.local.*
# Local tool state that only `.git/info/exclude` used to hide — a fresh
# clone running the same tooling would otherwise see them in `git status`.
**/.claude/scheduled_tasks.lock
**/.impeccable/
.soak-logs/

# Benchmark run output — one JSON per run, kept locally until the baseline
# format settles. Committing them before then would bake a schema nobody has
# had to read twice yet.
benchmarks/results/
